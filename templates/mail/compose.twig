{% extends "layout.twig" %}

{% block content %}
  <h1>Compose message</h1>

  <p>
    SMTP acceptance is not delivery. A submission marked &ldquo;SMTP accepted&rdquo; was accepted by the
    outgoing server, but this panel cannot confirm that it reached a recipient&rsquo;s inbox.
  </p>
  <p>
    Bcc recipients receive the message, but their addresses are only used in the SMTP envelope and are
    not shown to other recipients.
  </p>

  {% if accounts is empty %}
    <p role="status">No enabled sending accounts are available. Enable an account before sending.</p>
  {% endif %}

  <form method="post" action="/compose" autocomplete="off">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <input type="hidden" name="operation_id" value="{{ operation_id }}">

    <p>
      <label for="account_id">Sending account</label><br>
      <select id="account_id" name="account_id" required>
        <option value="">Select an account</option>
        {% for account in accounts %}
          <option value="{{ account.public_id }}"{% if old.account_id|default('') == account.public_id %} selected{% endif %}>
            {{ account.label }} &lt;{{ account.from_email }}&gt;
          </option>
        {% endfor %}
      </select>
    </p>

    <p>
      <label for="to">To</label><br>
      <textarea id="to" name="to" rows="3" cols="60" maxlength="10000" required>{{ old.to|default('') }}</textarea><br>
      <small>Separate addresses with commas, semicolons, or new lines.</small>
    </p>

    <p>
      <label for="cc">Cc</label><br>
      <textarea id="cc" name="cc" rows="2" cols="60" maxlength="10000">{{ old.cc|default('') }}</textarea>
    </p>

    <p>
      <label for="bcc">Bcc</label><br>
      <textarea id="bcc" name="bcc" rows="2" cols="60" maxlength="10000">{{ old.bcc|default('') }}</textarea><br>
      <small>Bcc addresses stay in the SMTP envelope and are not disclosed to other recipients.</small>
    </p>

    <p>
      <label for="subject">Subject</label><br>
      <input id="subject" type="text" name="subject" maxlength="200" size="60" value="{{ old.subject|default('') }}" required>
    </p>

    <p>
      <label for="text">Plain-text body</label><br>
      <textarea id="text" name="text" rows="12" cols="60">{{ old.text|default('') }}</textarea>
    </p>

    <p>
      <label for="html">Optional HTML body</label><br>
      <textarea id="html" name="html" rows="8" cols="60">{{ old.html|default('') }}</textarea><br>
      <small>Leave empty to send only the plain-text body.</small>
    </p>

    <p>
      <button type="submit"{% if accounts is empty %} disabled{% endif %}>Queue submission</button>
    </p>
  </form>

  <p><a href="/outbox">View Outbox</a></p>
{% endblock %}
